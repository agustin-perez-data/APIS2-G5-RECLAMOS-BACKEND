# ---------------------------------------------------------------------------
# CityPass+ | Group 5 - Claims and Citizen Participation
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# --- Database ----------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI
# The app rewrites the "postgresql://" prefix to "postgresql+asyncpg://" on its
# own, so pasting the URI as-is works.
#
# Session pooler (port 5432)     -> recommended for Alembic migrations
# Transaction pooler (port 6543) -> recommended for the API; the code disables
#   the prepared statement cache automatically on that port.
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR@db.XXXXXXXX.supabase.co:5432/postgres

# Local Postgres from docker-compose (alternative for offline development)
# DATABASE_URL=postgresql+asyncpg://citypass:citypass@localhost:5432/reclamos

DB_ECHO=false

# --- Kafka / Redpanda --------------------------------------------------------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP=reclamos-service
KAFKA_CLIENT_ID=reclamos-service

# --- Security (JWT issued by Group 2 - Federated Login) ----------------------
AUTH_ENABLED=true
JWT_ALGORITHM=HS256
JWT_SECRET=cambiar-por-el-secreto-compartido-del-grupo-2
JWT_ISSUER=citypass-auth
JWT_AUDIENCE=citypass
# For RS256 the shared secret is replaced by the identity service's JWKS:
# JWT_ALGORITHM=RS256
# JWT_JWKS_URL=https://auth.citypass.local/.well-known/jwks.json

# --- Development login (Entrega 1 only) --------------------------------------
# Mounts POST /api/v1/auth/dev/login with a fixed set of demo users. Refuses to
# start if ENVIRONMENT is anything other than a development one. Delete both
# lines once Group 2's issuer is reachable.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_TOKEN_HORAS=8

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
